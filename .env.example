# Copy to .env (optional). Everything works with no .env at all.

# Port for the local server
PORT=3000

# Service zone: comma-separated postal-code prefixes (FSAs). Default: M8V (Humber Bay Shores / Mimico)
# SERVICE_ZONE_PREFIXES=M8V,M8W

# ── Stripe TEST MODE (optional) ──
# Leave blank to use the built-in mock checkout. Only sk_test_ keys are accepted;
# live keys are refused. Get test keys from the Stripe dashboard (Developers → API keys, "Test mode").
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
